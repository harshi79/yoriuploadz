# Copy this file to .env (it is git-ignored) and fill in what you need.
# In Netlify, set the same values under Site settings → Environment variables.

# OPTIONAL: makes the service private. When set, every upload request must
# include the matching key — the site will ask visitors for it once and
# store it in their browser. Leave unset to allow anyone to upload.
APP_SECRET=

# OPTIONAL: your Catbox userhash. Uploads are stored as anonymous (yours)
# files if left empty. Share this carefully — anyone with it can manage
# your Catbox account.
CATBOX_USERHASH=
