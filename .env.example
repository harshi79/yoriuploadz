# Copy this file to .env (it is git-ignored) and fill in what you need.
# In Netlify, set the same values under Site settings → Environment variables.

# OPTIONAL: makes the service private. When set, every upload request must
# include the matching key — the site will ask visitors for it once and
# store it in their browser. Leave unset to allow anyone to upload.
APP_SECRET=

# OPTIONAL: your Catbox userhash. Uploads are stored as anonymous (yours)
# files if left empty. Share this carefully — anyone with it can manage
# your Catbox account.
CATBOX_USERHASH=

# OPTIONAL: total milliseconds the relay may spend talking to storage
# providers, including retries. Keep it below your Netlify function timeout
# (10 s on most plans) — otherwise the platform kills the function and the
# browser gets an unreadable 502 instead of a proper error message.
UPLOAD_BUDGET_MS=9000

# OPTIONAL: change or restrict the storage failover chain.
# Valid ids: litterbox (temp), catbox (permanent), zerox (0x0.st), tmpfiles.
# UPSTREAM_ORDER=zerox,catbox
# UPSTREAM_DISABLED=tmpfiles

# OPTIONAL: point providers at your own endpoints (used for local testing).
# UPSTREAM_TEMP_URL=
# UPSTREAM_PERMANENT_URL=
# UPSTREAM_ZEROX_URL=
# UPSTREAM_TMPFILES_URL=
